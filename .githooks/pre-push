#!/usr/bin/env python3
"""
pre-push: analiza el diff con LiteLLM antes de subir a GitHub.
Bloquea el push si encuentra findings CRITICAL.
Fail-open si LiteLLM no responde.
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

# Locate repo root via git, then add ops/cron to path for litellm_client
try:
    _repo_root = Path(
        subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            stderr=subprocess.DEVNULL,
        ).decode().strip()
    )
except subprocess.CalledProcessError:
    _repo_root = Path(__file__).resolve().parent.parent

sys.path.insert(0, str(_repo_root / "ops" / "cron"))

import litellm_client  # noqa: E402  (path set above)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

MAX_DIFF_CHARS = 8_000

WATCH_PATHS = [
    "src/api/",
    "src/data/",
    "src/scraper/",
    "src/ingestion/",
]

_PROMPT_FILE = _repo_root / "ops" / "prompts" / "pre-push.txt"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _has_parent_commit() -> bool:
    """Return True if HEAD has at least one parent (i.e. not the initial commit)."""
    result = subprocess.run(
        ["git", "rev-parse", "--verify", "HEAD~1"],
        capture_output=True,
    )
    return result.returncode == 0


def get_diff() -> str:
    """Return unified diff of changed files in WATCH_PATHS, or empty string."""
    try:
        if _has_parent_commit():
            result = subprocess.run(
                ["git", "diff", "HEAD~1..HEAD", "--", *WATCH_PATHS],
                capture_output=True,
                text=True,
            )
        else:
            # Initial commit: compare against empty tree
            result = subprocess.run(
                ["git", "diff", "--cached", "--", *WATCH_PATHS],
                capture_output=True,
                text=True,
            )
        return result.stdout.strip()
    except Exception:
        return ""


def load_prompt(diff: str) -> str:
    try:
        template = _PROMPT_FILE.read_text(encoding="utf-8")
        return template.replace("{diff}", diff[:MAX_DIFF_CHARS])
    except OSError:
        # Fallback inline prompt if file is missing
        return (
            "Analiza este diff de Python/FastAPI buscando: JWT sin tenant_id, "
            "SQL injection (f-strings en asyncpg), SSRF, secrets hardcodeados. "
            "Responde CRITICAL/HIGH/MEDIUM linea descripcion, o CLEAN.\n\nDiff:\n"
            + diff[:MAX_DIFF_CHARS]
        )


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    diff = get_diff()
    if not diff:
        sys.exit(0)

    print("🔍 Analizando cambios con LiteLLM...", file=sys.stderr)
    response = litellm_client.call(load_prompt(diff))

    if response is None:
        # fail-open: LiteLLM unavailable, warning already printed by client
        sys.exit(0)

    findings = litellm_client.parse_findings(response)

    if findings:
        for f in findings:
            print(f)
    else:
        print("✅ Sin hallazgos de seguridad")

    if litellm_client.has_critical(findings):
        print(
            "\n❌ Push bloqueado — findings CRITICAL. Corrige antes de hacer push.",
            file=sys.stderr,
        )
        print("   Para saltarlo: git push --no-verify", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
