#!/usr/bin/env bash
# pre-commit: ggshield secret-scan + ruff lint + format sobre archivos Python.
# Sin IA — rápido, feedback inmediato.
set -euo pipefail

# pipx instala en ~/.local/bin; lo aseguramos para guis de git.
export PATH="/root/.local/bin:$HOME/.local/bin:$PATH"

# ── 1) ggshield secret-scan del diff staged ─────────────────────────────────
# Bloquea el commit si encuentra cualquier secret (API key, token, generic
# password con palabras como "secret"/"password"). Requiere haber corrido
# `ggshield auth login` o tener GITGUARDIAN_API_KEY exportada.
# Fail-open si ggshield no esta instalado (warning, no bloqueo).
if command -v ggshield &>/dev/null; then
    echo "🛡  ggshield: escaneando diff staged..."
    if ! ggshield secret scan pre-commit; then
        echo "❌ ggshield detecto un secreto. Corrige o usa: git commit --no-verify"
        exit 1
    fi
else
    echo "⚠️  ggshield no encontrado — saltando secret-scan."
    echo "    Instalar: pipx install ggshield && ggshield auth login"
fi

# ── 2) ruff lint + format (solo Python) ─────────────────────────────────────
# Collect staged .py files into an array (handles spaces in paths)
mapfile -t STAGED < <(
    git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true
)

# Nothing to check
[[ ${#STAGED[@]} -eq 0 ]] && exit 0

if ! command -v ruff &>/dev/null; then
    echo "⚠️  ruff no encontrado — instalar con: pip install ruff"
    exit 0
fi

echo "🔎 ruff: revisando ${#STAGED[@]} archivo(s) Python..."

# Lint
if ! ruff check "${STAGED[@]}"; then
    echo "❌ ruff check falló. Corrige los errores o usa: git commit --no-verify"
    exit 1
fi

# Format check (no modifica, solo verifica)
if ! ruff format --check "${STAGED[@]}"; then
    echo "❌ ruff format: hay archivos sin formatear."
    echo "   Ejecuta: ruff format ${STAGED[*]}"
    echo "   O usa: git commit --no-verify"
    exit 1
fi

echo "✅ ruff OK"
exit 0
