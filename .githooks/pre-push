#!/usr/bin/env python3
"""
pre-push: analiza el diff con LiteLLM antes de subir a GitHub.
Bloquea el push si encuentra findings CRITICAL.
Fail-open si LiteLLM no responde.
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

# Locate repo root via git, then add ops/cron to path for litellm_client
try:
    _repo_root = Path(
        subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            stderr=subprocess.DEVNULL,
        ).decode().strip()
    )
except subprocess.CalledProcessError:
    _repo_root = Path(__file__).resolve().parent.parent

sys.path.insert(0, str(_repo_root / "ops" / "cron"))

import litellm_client  # noqa: E402  (path set above)

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# Maximum diff characters sent to the model.
# Derived from cerebro-lite context budget (~8k chars leaves room for the prompt).
MAX_DIFF_CHARS = 8_000

WATCH_PATHS = [
    "src/api/",
    "src/data/",
    "src/scraper/",
    "src/ingestion/",
]

_PROMPT_FILE = _repo_root / "ops" / "prompts" / "pre-push.txt"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def get_diff() -> str:
    """
    Return unified diff of changed files in WATCH_PATHS, or empty string.

    Uses a single subprocess call: tries HEAD~1..HEAD first (normal commit),
    falls back to --cached if HEAD has no parent (initial commit).
    """
    try:
        result = subprocess.run(
            ["git", "diff", "HEAD~1..HEAD", "--", *WATCH_PATHS],
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            diff = result.stdout.strip()
            if diff:
                return diff
        # HEAD~1 doesn't exist (initial commit) — compare staged files instead
        result = subprocess.run(
            ["git", "diff", "--cached", "--", *WATCH_PATHS],
            capture_output=True,
            text=True,
        )
        return result.stdout.strip()
    except Exception:
        return ""


def load_prompt(diff: str) -> str:
    """
    Load prompt template from ops/prompts/pre-push.txt and inject the diff.
    Exits with error if the prompt file is missing — no silent fallback.
    """
    try:
        template = _PROMPT_FILE.read_text(encoding="utf-8")
    except OSError:
        print(
            f"❌ Prompt file not found: {_PROMPT_FILE}\n"
            "   Ensure ops/prompts/pre-push.txt exists in the repository.\n"
            "   Para saltarlo: git push --no-verify",
            file=sys.stderr,
        )
        sys.exit(1)

    truncated = diff[:MAX_DIFF_CHARS]
    suffix = "\n... [TRUNCADO — diff demasiado grande para análisis completo]\n" if len(diff) > MAX_DIFF_CHARS else ""
    return template.replace("{diff}", truncated + suffix)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    diff = get_diff()
    if not diff:
        sys.exit(0)

    print("🔍 Analizando cambios con LiteLLM...", file=sys.stderr)
    response = litellm_client.call(load_prompt(diff))

    if response is None:
        # fail-open: LiteLLM unavailable, warning already printed by client
        sys.exit(0)

    findings = litellm_client.parse_findings(response)

    if findings:
        for f in findings:
            print(f)
    else:
        print("✅ Sin hallazgos de seguridad")

    if litellm_client.has_critical(findings):
        print(
            "\n❌ Push bloqueado — findings CRITICAL. Corrige antes de hacer push.",
            file=sys.stderr,
        )
        print("   Para saltarlo: git push --no-verify", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
