# =============================================================================
# LinkAnvil — Variables de entorno
# Copia este archivo como .env y rellena los valores reales
# NUNCA commitear .env al repositorio (está en .gitignore)
# =============================================================================

# Las claves marcadas con _CHANGE_ME las rellena automáticamente `bash up.sh`.
# Solo NVIDIA_API_KEY (más abajo) requiere acción humana.

# --- PostgreSQL ---
POSTGRES_USER=cerebro
POSTGRES_PASSWORD=cerebro_db_pass_CHANGE_ME
POSTGRES_DB=cerebro_brain

# --- Redis ---
REDIS_PASSWORD=cerebro_redis_pass_CHANGE_ME

# --- RabbitMQ ---
RABBITMQ_USER=cerebro
RABBITMQ_PASS=cerebro_pass_CHANGE_ME
RABBITMQ_VHOST=cerebro
# Cookie Erlang para auth entre nodos. Single-node = irrelevante en
# tiempo de ejecución pero obligatoria para no dejar literales en el
# repo. Auto-generada por up.sh si está en _CHANGE_ME.
RABBITMQ_ERLANG_COOKIE=cerebro_erlang_cookie_CHANGE_ME

# --- LiteLLM Gateway ---
# auto-generado por up.sh si está en _CHANGE_ME
LITELLM_MASTER_KEY=sk-cerebro-master-key_CHANGE_ME

# ----------------------------------------------------------------------
# Proveedores LLM
# ----------------------------------------------------------------------
# bash up.sh te preguntará interactivamente qué proveedores activar y en qué
# orden, y rellenará estas variables. El render de infra/litellm/config.yaml
# se hace cada vez que ejecutas up.sh leyendo lo que haya aquí.
#
# Catálogo y dimensiones de embeddings: infra/litellm/providers.yaml
#
# LLM_PROVIDERS_PRIORITY  CSV en orden de prioridad. Solo se activan los que
#                         tengan su <PROVIDER>_API_KEY rellenada de verdad.
#                         Determina la cadena estricta de fallback de LiteLLM.
# EMBEDDINGS_PROVIDER     "auto" = primer proveedor con la dim correcta.
#                         O nombre concreto (nvidia, mistral, cohere, ...).
# EMBEDDINGS_DIM          Dimensión del vector (1024 default). Si cambia,
#                         qdrant-init recrea las colecciones (destructivo).
LLM_PROVIDERS_PRIORITY=
EMBEDDINGS_PROVIDER=auto
EMBEDDINGS_DIM=1024

# API keys (deja vacías las que no uses)
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=cerebro_n8n_pass_CHANGE_ME

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=cerebro_grafana_pass_CHANGE_ME

# --- Auth API ---
# Secreto JWT: genera uno con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cerebro_jwt_dev_secret_CHANGE_ME
# --- Telegram webhooks (Tailscale Funnel, opcional) ---
# Auth-key reusable de Tailscale para que el sidecar `tailscale-funnel`
# se registre en tu tailnet. Generar en:
#   https://login.tailscale.com/admin/settings/keys
# Marcar Reusable=ON, Ephemeral=OFF, Pre-approved=ON (si usas device approval).
# Solo se necesita la primera vez; después basta con el volumen tailscale-state.
TS_AUTHKEY=

# ── Tailscale Funnel — FRONTEND PÚBLICO (profile "public") ──────────────────
# Activado por `bash up.sh --public` o `bash up.sh` respondiendo "s" al prompt.
# El sidecar `tailscale-web` expone cerebro-web (puerto 3000 interno) como
# https://<TS_PUBLIC_HOSTNAME>.<tu-tailnet>.ts.net con HTTPS automático.
#
# Genera un authkey en: https://login.tailscale.com/admin/settings/keys
#   ✓ Reusable        ✗ Ephemeral        Tag: tag:funnel-web (opcional)
# Tras el primer enrolamiento queda persistido en el volumen
# cerebro-tailscale-web-state; puedes vaciar la línea TS_AUTHKEY_WEB.
TS_PUBLIC_HOSTNAME=linkanvil
TS_AUTHKEY_WEB=

# URL pública del Funnel (sin barra final). Tras `docker compose --profile
# telegram up -d tailscale-funnel`, descúbrela con:
#   docker logs cerebro-tailscale 2>&1 | grep -i 'https://'
# Formato: https://linkanvil-ingest.<tu-tailnet>.ts.net
PUBLIC_INGESTION_URL=

# --- Sistema de obsolescencia (F-05.1 + F-05.2) ---
# Token compartido entre cerebro-api y el workflow n8n que dispara
# /admin/audit-cron. Generar con: openssl rand -hex 32
AUDIT_CRON_TOKEN=
# Días que un recurso permanece en cuarentena antes de expirar definitivamente.
OBSOLESCENCE_GRACE_DAYS=30

# --- Frontend Next.js ---
# URL de la auth API accesible desde el navegador del usuario
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- MCP servers (Claude Code) ---
# n8n: generar en http://localhost:5678/settings/api tras levantar el stack
N8N_API_KEY=
# GitHub: https://github.com/settings/tokens (scopes: repo, workflow)
GITHUB_TOKEN=
# Brave Search API: https://brave.com/search/api/ (free tier 2000 req/mes)
BRAVE_API_KEY=
# Telegram: token de @BotFather (dejar vacío hasta crear el bot, paso 2 del roadmap)
TELEGRAM_BOT_TOKEN=

# ----------------------------------------------------------------------
# BYOK — Bring Your Own Key (LiteLLM virtual keys per-tenant)
# ----------------------------------------------------------------------
# Clave maestra Fernet para cifrar las LLM keys de los usuarios en BD.
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUERIDA. cerebro-api falla al arrancar si está vacía.
LLM_KEYS_ENCRYPTION_KEY=

# Virtual-keys de LiteLLM que el tenant demo (user_demo_landing) usa.
# Si quedan vacías, el seed (ops/seed_demo_user.py) deja las columnas
# NULL y el demo no podrá hacer requests LLM hasta que se rellenen y
# se re-corra el seed.
DEMO_KEY_LITE=
DEMO_KEY_EMBEDDINGS=
DEMO_KEY_PRO=

# ----------------------------------------------------------------------
# Demo tenant (default true — flow demo del frontend funcional out-of-the-box)
# ----------------------------------------------------------------------
# Si true, cerebro-seed-demo inserta el usuario demo@linkanvil.io
# + 18 recursos de ejemplo en el primer up. Requerido para que el
# botón "Probar demo" del frontend funcione (sin esto, el bootstrap
# de virtual-keys deja el demo user con un placeholder "!bootstrap-no-login!"
# como password_hash, que rompe el flow demo end-to-end).
# Cambiar a false en producción donde no quieres datos de ejemplo.
SEED_DEMO=true
DEMO_EMAIL=demo@linkanvil.io
